    "@babel/preset-env": "^7.23.2",
    "@babel/preset-react": "^7.29.7",
    "@playwright/test": "^1.45.2",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/jest-runner": "^10.1.1",
